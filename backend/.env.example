# "claude_code" = captioning runs through the local `claude` CLI, billed to your
#   Claude subscription (needs `claude` on PATH and you logged in via `claude auth login`).
# "api" = captioning calls the Anthropic API directly with ANTHROPIC_API_KEY below (metered billing).
CAPTION_PROVIDER=claude_code
CAPTION_MODEL=claude-opus-5
ANTHROPIC_API_KEY=sk-ant-...
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
